rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGLAS DE SEGURIDAD — Asistente HYS
    // Principio: negar todo por defecto, permitir solo lo explícitamente necesario.
    // =========================================================================

    // ── Funciones Helper de Autenticación y Tenant ─────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Datos de usuario (Aislamiento por UID) ──────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Subcolección de datos sincronizados (módulos EHS)
      // Lectura pública habilitada (excepto subscriptionData) para permitir visualización vía QR público (/v/:uid/:cat/:id) sin login
      match /data/{key} {
        allow read: if key != 'subscriptionData' || isOwner(uid);
        // CRÍTICO: subscriptionData SOLO puede ser escrito por el backend / Admin SDK
        allow write: if isOwner(uid)
                     && key != 'subscriptionData'
                     && request.resource.data.keys().size() < 150
                     && request.resource.size() < 1024 * 1024; // máx 1 MB por documento
      }

      // Resto de subcolecciones (legajos, fcmTokens, etc.)
      match /{subcollection}/{docId=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
                     && subcollection != 'data'
                     && request.resource.data.keys().size() < 150
                     && request.resource.size() < 500 * 1024;
      }
    }

    // ── Datos de Empresa / Multi-Tenant ─────────────────────────────────────
    // Colección jerárquica para empresas y consultoras
    match /companies/{companyId}/{document=**} {
      // Lectura y escritura permitida si el token del usuario coincide con el companyId o si es propietario
      allow read: if isAuthenticated() && (request.auth.token.companyId == companyId || isOwner(resource.data.createdBy));
      allow write: if isAuthenticated() && (request.auth.token.companyId == companyId || isOwner(request.resource.data.createdBy))
                    && request.resource.size() < 1024 * 1024;
    }

    // ── Subscripción (PAYWALL) ─────────────────────────────────────────────────
    // Bloqueo explícito adicional para clientes; solo Admin SDK puede modificarlo
    match /users/{uid}/data/subscriptionData {
      allow read:  if isOwner(uid);
      allow write: if false; // Solo Admin SDK
    }

    // ── Solicitudes de registro ──────────────────────────────────────────────
    match /registration_requests/{docId} {
      allow read, write: if false;
    }

    // ── Códigos de reseteo de contraseña ─────────────────────────────────────
    match /passwordResetCodes/{uid} {
      allow read, write: if false;
    }

    // ── Colecciones de Verificación Pública (QR / Hash de documentos) ────────
    match /public_verifications/{documentId} {
      allow read: if true; // Permite la visualización y verificación pública del informe sin login
      allow write: if isAuthenticated()
                    && request.resource.size() < 1024 * 1024; // Permite publicar snapshot al compartir por QR
    }

    // ── Deny-all por defecto ──────────────────────────────────────────────────
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

