rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGLAS DE SEGURIDAD — Asistente HYS
    // Principio: negar todo por defecto, permitir solo lo explícitamente necesario.
    // =========================================================================

    // ── Funciones Helper de Autenticación y Tenant ─────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Datos de usuario (Aislamiento por UID) ──────────────────────────────
    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);

      allow write: if isOwner(uid)
                   && request.resource.data.keys().size() < 150
                   && request.resource.size() < 500 * 1024; // máx 500 KB por documento
    }

    // ── Datos de Empresa / Multi-Tenant ─────────────────────────────────────
    // Colección jerárquica para empresas y consultoras
    match /companies/{companyId}/{document=**} {
      // Lectura y escritura permitida si el token del usuario coincide con el companyId o si es propietario
      allow read: if isAuthenticated() && (request.auth.token.companyId == companyId || isOwner(resource.data.createdBy));
      allow write: if isAuthenticated() && (request.auth.token.companyId == companyId || isOwner(request.resource.data.createdBy))
                    && request.resource.size() < 1024 * 1024;
    }

    // ── Subscripción (PAYWALL) ─────────────────────────────────────────────────
    // Solo el backend (Admin SDK) puede escribir subscriptionData.
    // Los clientes solo pueden leer su propio estado de suscripción.
    match /users/{uid}/data/subscriptionData {
      allow read:  if isOwner(uid);
      allow write: if false; // Solo Admin SDK
    }

    // ── Solicitudes de registro ──────────────────────────────────────────────
    match /registration_requests/{docId} {
      allow read, write: if false;
    }

    // ── Códigos de reseteo de contraseña ─────────────────────────────────────
    match /passwordResetCodes/{uid} {
      allow read, write: if false;
    }

    // ── Colecciones de Verificación Pública (QR / Hash de documentos) ────────
    match /public_verifications/{documentId} {
      allow read: if true; // Permite la verificación pública del hash del informe
      allow write: if false; // Solo generado por backend o usuario autenticado mediante Cloud Function
    }

    // ── Deny-all por defecto ──────────────────────────────────────────────────
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

